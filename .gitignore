# local working files
CLAUDE.md
.claude/

# datasheets - kept on disk, the README lists the parts
datasheets/

# Bosch BSEC2 - closed source under Bosch's licence, the README says how to get it
firmware/App/drivers/bsec/

# docs - the case note, the car numbers, my notes, the pictures and the BOM are public
docs/*
!docs/dash_case.md
!docs/vehicle_info.md
!docs/notes.md
!docs/3Dtop.jpeg
!docs/3Dside.jpeg
!docs/3Dbottom.jpeg
!docs/pcb.jpeg
!docs/case_pcb_side.jpeg
!docs/stm32_main_page.jpeg
!docs/sensors.jpeg
!docs/display.jpeg
!docs/bom.csv

# 3D models of the custom parts - third-party files, kept on disk, not published
hardware/libraries/*/*.3dshapes/

# hardware outputs - kept on disk, not published. the case STEP exports stay
# public, so the case opens in any CAD tool, not only FreeCAD
hardware/pcb/fab/
hardware/case/*.stl
hardware/case/*.3mf
!hardware/case/*.step

# kicad local and temporary files
*-backups/
*.kicad_prl
_autosave-*
fp-info-cache
*.lck
~*.lck
.history/

# freecad backups
*.FCBak

# macOS
.DS_Store
